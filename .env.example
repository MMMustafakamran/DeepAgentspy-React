# CopilotKit + Deep Agents test suite — environment
#
# There are TWO processes here, so there are two places these go:
#
#   backend/.env         read by the LangGraph dev server (langgraph.json points at it)
#   frontend/.env.local  read by Next.js at startup
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env — required ──────────────────────────────────────────────────

# OpenAI API key. Every agent runs on an OpenAI model via langchain-openai.
OPENAI_API_KEY=sk-...


# ── backend/.env — optional ──────────────────────────────────────────────────

# Model for every agent. The doc pages this repo implements name two different
# ids across them — `gpt-4o` on Quickstart and Tool Rendering, `gpt-5.4` on
# Dynamic Schema A2UI and Predictive State Updates — so all agents read this
# instead of hardcoding one each. Defaults to gpt-4o.
#
# The Dynamic Schema A2UI route is the one that notices: a weaker model writes
# component trees that violate the "exactly one component with id root" rule
# and render blank.
# OPENAI_MODEL=gpt-4o


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Where the Next runtime route forwards agent runs. This is the LangGraph dev
# server. Defaults to http://localhost:8123 — the port the Quickstart uses and
# the one `langgraph dev --port 8123` binds.
#
# If you change the port, change it in both places.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# LangSmith / LangGraph Platform key, sent as `langsmithApiKey` on every
# LangGraphAgent. A locally running `langgraph dev` does not check it, so it is
# empty in local development — the Quickstart's snippet defaults it to "" for
# the same reason. Only needed against a LangGraph Platform deployment.
# LANGSMITH_API_KEY=lsv2_...

# Silences the runtime's anonymous telemetry notice on startup.
# COPILOTKIT_TELEMETRY_DISABLED=true
